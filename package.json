{
  "name": "dsh-mcp-test",
  "version": "0.1.0",
  "description": "Tool-surface snapshot and drift gate for DeepSeek Harness: records every visible tool schema (including MCP tools), diffs upgrades against the baseline, and refuses silent surface changes",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "schema-drift",
    "supply-chain",
    "ai-agents"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-mcp-test.git"
  }
}
